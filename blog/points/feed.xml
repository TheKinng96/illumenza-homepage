---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<!--
  Per-app RSS feed. The site-wide /blog/feed.xml stays the frozen contract the
  Mails app consumes; this one exists so an app's own landing page can show its
  own articles without filtering by tag, which would break the moment a tag is
  reused across apps.
-->
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>Illumenza Points ブログ</title>
    <link>{{ '/blog/points/' | absolute_url }}</link>
    <description>カラーミーショップ向けロイヤルティアプリ Illumenza Points の記事。</description>
    <language>ja</language>
    <atom:link href="{{ '/blog/points/feed.xml' | absolute_url }}" rel="self" type="application/rss+xml" />
    {%- assign app_posts = site.posts | where: "app", "points" %}
    {%- if app_posts.first %}
    <lastBuildDate>{{ app_posts.first.date | date_to_rfc822 }}</lastBuildDate>
    {%- endif %}
    {%- for post in app_posts limit: 30 %}
    <item>
      <title>{{ post.title | xml_escape }}</title>
      <link>{{ post.url | absolute_url }}</link>
      <guid isPermaLink="true">{{ post.url | absolute_url }}</guid>
      <description>{{ post.description | default: post.excerpt | strip_html | normalize_whitespace | xml_escape }}</description>
      <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
      {%- for tag in post.tags %}
      <category>{{ tag | xml_escape }}</category>
      {%- endfor %}
    </item>
    {%- endfor %}
  </channel>
</rss>
