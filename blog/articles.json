---
layout: null
---
{%- comment -%}
  Every post, as JSON, for the client-side filter and search on /blog/.

  /blog/ paginates at 10, so the DOM only ever holds one page of posts. Search
  has to reach the ones that are not on screen, which is what this file is for.
  It is fetched on the reader's first interaction with the filter bar, not on
  page load — nobody who only reads the list pays for it.

  Named articles.json rather than index.json so it cannot collide with the
  paginated /blog/index.html output.
{%- endcomment -%}
[
{%- for post in site.posts -%}
{%- assign body_chars = post.content | strip_html | strip_newlines | size -%}
{%- assign read_minutes = body_chars | divided_by: 500 | plus: 1 -%}
{%- assign card_image = post.thumbnail | default: post.heroImage | default: '' -%}
{%- assign section_label = site.data.sections[post.section].label | default: '' -%}
{"title":{{ post.title | jsonify }},"url":{{ post.url | jsonify }},"description":{{ post.description | strip_newlines | jsonify }},"app":{{ post.app | default: '' | jsonify }},"section":{{ post.section | default: '' | jsonify }},"sectionLabel":{{ section_label | jsonify }},"tags":[{% for tag in post.tags %}{"name":{{ tag | jsonify }},"slug":{{ tag | slugify | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}],"minutes":{{ read_minutes }},"image":{{ card_image | jsonify }},"iso":{{ post.date | date_to_xmlschema | jsonify }},"date":{{ post.date | date: '%Y年%-m月%-d日' | jsonify }}}{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]
